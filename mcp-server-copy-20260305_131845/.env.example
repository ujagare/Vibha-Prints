GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here

# Image generation
FREEPIK_API_KEY=your_freepik_api_key_here
FREEPIK_API_URL=https://api.freepik.com/v1/ai/text-to-image

# Google SEO audit (PageSpeed Insights API key)
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Google integrations via webhook (Apps Script / Cloud Run)
# Quote rows -> Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=
# Calendar booking -> Google Calendar + Meet link
GOOGLE_CALENDAR_WEBHOOK_URL=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=codesunny
MONGODB_LEADS_COLLECTION=leads

# Supabase (chat session storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional if using RLS-safe public key instead of service key
SUPABASE_ANON_KEY=
SUPABASE_SESSIONS_TABLE=chat_sessions

# Optional lead automation webhook (n8n / Zapier / Make)
LEAD_AUTOMATION_WEBHOOK_URL=

# Inbound email AI auto-reply (client replies -> AI reads -> sends response)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
INBOUND_AUTO_REPLY_ENABLED=true
INBOUND_EMAIL_MAX_PER_RUN=20
INBOUND_EMAIL_POLL_SECONDS=120

# SMTP (required for inbound auto-reply)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=info@vibhaprints.com
SMTP_PASS=
SMTP_FROM=info@vibhaprints.com
ADMIN_EMAIL=info@vibhaprints.com
BROCHURE_PATH=./brochure.pdf

# Website bridge
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FOLLOWUP_SCHEDULER_ENABLED=false
FOLLOWUP_SCHEDULER_TIME=09:00

# WhatsApp / Green API
WHATSAPP_PHONE_NUMBER=8624948046
WHATSAPP_ENABLED=true
WHATSAPP_AUTO_REPLY_ENABLED=true
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_BASE_URL=https://api.green-api.com

# Automation Hub
# once = run one cycle and exit, loop = run continuously
AUTOMATION_HUB_MODE=loop
AUTOMATION_POLL_SECONDS=120

# Weekly SEO report URLs (comma-separated)
SEO_REPORT_URLS=https://codesunny.com,https://codesunny.com/contact

# Uptime/SSL monitor domains (comma-separated)
MONITOR_DOMAINS=codesunny.com
