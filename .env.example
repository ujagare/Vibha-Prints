# Environment
NODE_ENV=production

# Application URL
VITE_APP_URL=https://www.vibhaprints.com/

# Supabase (Frontend & Backend)
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_SESSIONS_TABLE=chat_sessions

# Chatbot Automation API (Frontend)
VITE_CHATBOT_API_URL=https://vibha-art-backend.onrender.com/api/chat
VITE_CHATBOT_API_KEY=
VITE_CHATBOT_MODEL=openai/gpt-oss-120b
VITE_CHATBOT_REQUEST_ID=your_request_id_here
VITE_CHATBOT_LEAD_API_URL=
VITE_CHATBOT_SOCKET_URL=

# Groq API (Backend only)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini CLI
GEMINI_API_KEY=your_gemini_api_key_here


GEMINI_MODEL=gemini-1.5-pro

# Zoho Mail SMTP (Backend)
ZOHO_SMTP_HOST=smtppro.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=your_zoho_email@vibhaprints.com
ZOHO_SMTP_PASS=your_zoho_app_password_here
MAIL_FROM=your_zoho_email@vibhaprints.com
MAIL_TO=your_zoho_email@vibhaprints.com
HOT_LEAD_ALERT_EMAIL=your_zoho_email@vibhaprints.com
BROCHURE_PATH=/path/to/brochure.pdf
BROCHURE_NOTIFY_API_KEY=your_api_key_here
CONTACT_NOTIFY_API_KEY=your_api_key_here

# IMAP Configuration
IMAP_HOST=imap.zoho.in
IMAP_PORT=993
IMAP_USER=your_zoho_email@vibhaprints.com
IMAP_PASS=your_zoho_app_password_here

# Brochure Lead Notification API (Frontend -> Backend)
VITE_BROCHURE_NOTIFY_API_URL=https://api.vibhaprints.com/api/create-lead
VITE_BROCHURE_NOTIFY_API_KEY=your_api_key_here
VITE_CONTACT_NOTIFY_API_URL=https://api.vibhaprints.com/api/create-lead
VITE_CONTACT_NOTIFY_API_KEY=your_api_key_here

# Follow-up Scheduler (Backend)
FOLLOWUP_SCHEDULER_ENABLED=true
FOLLOWUP_SCHEDULER_TIME=09:00

INBOUND_AUTO_REPLY_ENABLED=true
INBOUND_EMAIL_MAX_PER_RUN=20
INBOUND_EMAIL_POLL_SECONDS=120
# auto sends replies immediately; draft saves AI replies in Supabase email_reply_drafts
INBOUND_REPLY_MODE=auto

# WhatsApp Automation
WHATSAPP_PHONE_NUMBER=your_phone_number
WHATSAPP_API_URL=https://api.whatsapp.com/send
WHATSAPP_ENABLED=true
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token
GREEN_API_BASE_URL=https://your-instance-api-url.greenapi.com
WHATSAPP_NOTIFY_API_KEY=your_internal_whatsapp_api_key_here

WHATSAPP_AUTO_REPLY_ENABLED=true

# Analytics & Tracking (Update with your actual IDs)
VITE_HOTJAR_ID=your_hotjar_site_id
VITE_GOOGLE_ADS_CONVERSION_ID=your_google_ads_conversion_id
